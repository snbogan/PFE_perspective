initialize() {
    setSeed(321);

    initializeSLiMOptions(keepPedigrees=T);
    initializeMutationRate(1e-6);

    initializeMutationType("m1", 0.5, "n", 0.0, 0.2);  // plastic variant
    initializeMutationType("m2", 0.5, "n", 0.0, 0.2);  // constitutive variant

    initializeGenomicElementType("g1", c(m1, m2), c(1.0, 1.0));

    // Two loci at position 0 and 1
    initializeGenomicElement(g1, 0, 0);
    initializeGenomicElement(g1, 1, 1);

    initializeRecombinationRate(1e-8);

    defineConstant("INDUCTION_THRESHOLD", 3.0);
    defineConstant("INITIAL_ENV_MEAN", 1.0);
    defineConstant("ENV_SHIFT_RATE", 0.0005);

    defineGlobal("ENV_STATE", Dictionary());
    ENV_STATE.setValue("CURRENT_ENV_MEAN", INITIAL_ENV_MEAN);
}

1 early() {
    sim.addSubpop("p1", 50000);
}

1 late() {
    // Add m1 mutations at both loci to achieve starting frequency of 0.5
    target = asInteger(p1.individualCount * 0.5);  // Convert to integer
    
    // For locus 0
    sample_indivs = sample(p1.individuals, target);
    for (ind in sample_indivs) {
        // Add m1 mutation to one of the two genomes (randomly chosen)
        target_genome = ifelse(runif(1) < 0.5, ind.genome1, ind.genome2);
        target_genome.addNewDrawnMutation(m1, 0);
    }
    
    // For locus 1
    sample_indivs = sample(p1.individuals, target);
    for (ind in sample_indivs) {
        // Add m1 mutation to one of the two genomes (randomly chosen)
        target_genome = ifelse(runif(1) < 0.5, ind.genome1, ind.genome2);
        target_genome.addNewDrawnMutation(m1, 1);
    }
}

s1 10:10000 early() {
    new_mean = ENV_STATE.getValue("CURRENT_ENV_MEAN") + ENV_SHIFT_RATE;
    if (new_mean < INDUCTION_THRESHOLD) {
        ENV_STATE.setValue("CURRENT_ENV_MEAN", new_mean);
    } else {
        ENV_STATE.setValue("CURRENT_ENV_MEAN", INDUCTION_THRESHOLD);
    }
    catn("Tick " + community.tick + ": Environment mean = " + ENV_STATE.getValue("CURRENT_ENV_MEAN"));
}

modifyChild() {
    env = rnorm(1, ENV_STATE.getValue("CURRENT_ENV_MEAN"), 1.0);

    // Count m1 and m2 mutations across both parents at both loci
    all_muts = c(parent1.genomes[0].mutations, parent2.genomes[0].mutations);

    m1_count = 0;
    m2_count = 0;

    for (mut in all_muts) {
        if ((mut.position == 0 | mut.position == 1)) {
            if (mut.mutationType == m1)
                m1_count = m1_count + 1;
            else if (mut.mutationType == m2)
                m2_count = m2_count + 1;
        }
    }

    total_mut_count = m1_count + m2_count;

    // Determine phenotype
    if (total_mut_count >= 2) {
        if (m2_count >= 1) {
            phenotype = 1;  // constitutive
        } else {
            if (env > INDUCTION_THRESHOLD)
                phenotype = 1;  // plastic (induced)
            else
                phenotype = 0;
        }
    } else {
        phenotype = 0;
    }

    current_env = ENV_STATE.getValue("CURRENT_ENV_MEAN");

    if (phenotype == 1) {
        if ((current_env >= 1.0) & (current_env <= 3.0)) {
            // Plastic: peak at 2.0
            env_distance = abs(current_env - 2.0);
            fitness_effect = 2.0 - env_distance * 1.0;
        } else {
            // Constitutive: peak at 3.0
            env_distance = abs(current_env - 3.0);
            fitness_effect = 2.0 - env_distance * 1.0;
        }

        fitness_effect = max(min(fitness_effect, 2.0), 0.1);
        child.fitnessScaling = fitness_effect;
    }

    return T;
}

s2 10:10000 late() {
    plastic = 0;
    constitutive = 0;
    non_expr = 0;

    for (ind in p1.individuals) {
        muts = c(ind.genomes[0].mutations, ind.genomes[1].mutations);
        m1_count = 0;
        m2_count = 0;

        for (mut in muts) {
            if ((mut.position == 0 | mut.position == 1)) {
                if (mut.mutationType == m1)
                    m1_count = m1_count + 1;
                else if (mut.mutationType == m2)
                    m2_count = m2_count + 1;
            }
        }

        total_mut_count = m1_count + m2_count;

        if (total_mut_count >= 2) {
            if (m2_count >= 1)
                constitutive = constitutive + 1;
            else
                plastic = plastic + 1;
        } else {
            non_expr = non_expr + 1;
        }
    }

    catn("Tick " + community.tick +
         ": Plastic = " + plastic + "/" + p1.individualCount + " (" + format("%.3f", plastic/p1.individualCount) + ")" +
         ", Constitutive = " + constitutive + "/" + p1.individualCount + " (" + format("%.3f", constitutive/p1.individualCount) + ")" +
         ", Non-expressing = " + non_expr + "/" + p1.individualCount + " (" + format("%.3f", non_expr/p1.individualCount) + ")" +
         ", Env = " + format("%.2f", ENV_STATE.getValue("CURRENT_ENV_MEAN")));

    if (constitutive / p1.individualCount > 0.9) {
        catn("Constitutive phenotype fixed at tick " + community.tick);
        sim.simulationFinished();
    }
}

10000 late() {
    sim.simulationFinished();
}
